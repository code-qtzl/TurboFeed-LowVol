# ===========================================
# Server Configuration
# ===========================================
PORT=3001                        # Port the Express server listens on
NODE_ENV=development             # Environment: development | production

# ===========================================
# GenAI Configuration
# ===========================================
GENAI_PROVIDER=openai            # GenAI provider: openai
OPENAI_API_KEY=sk-your-openai-api-key-here

GENAI_TIMEOUT=30000              # API request timeout in milliseconds
GENAI_MAX_RETRIES=2              # Max retry attempts on failure
GENAI_MODEL=gpt-image-1          # OpenAI image model (gpt-image-1 recommended)
GENAI_IMAGE_QUALITY=medium       # Image quality: low | medium | high


# ===========================================
# Fal Video Generation
# ===========================================
FAL_KEY=your-fal-key-here
FAL_VIDEO_ENDPOINT=fal-ai/kling-video/v2.5-turbo/pro/image-to-video
FAL_IMAGE_EDIT_ENDPOINT=fal-ai/flux-pro/kontext
VIBE_PROMPT_DIR=../.github/workflows/time-of-day

# ===========================================
# Storage Configuration
# ===========================================
OUTPUT_DIR=outputs               # Directory for generated creative outputs

# ===========================================
# Asset Validation
# ===========================================
MAX_ASSET_SIZE=10485760          # Max upload size in bytes (10MB)
MIN_IMAGE_DIMENSION=800          # Minimum image width/height in pixels
